{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Tree",
  "version": "0.1.0",
  "identifier": "com.paruma.tasktree2026",
  "build": {
    "beforeDevCommand": "node scripts/prepare-frontend.mjs",
    "beforeBuildCommand": "node scripts/prepare-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Task Tree",
      "width": 640,
      "height": 720,
      "minWidth": 280,
      "minHeight": 300,
      "dragDropEnabled": false,
      "zoomHotkeysEnabled": true,
      "backgroundColor": "#fcfaf7"
    }],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/32x32.png"]
  }
}
