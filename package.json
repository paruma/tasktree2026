{
  "name": "tasktree2026",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "prepare:frontend": "node scripts/prepare-frontend.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "check": "eslint index.html scripts/*.mjs eslint.config.mjs --max-warnings 0",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.14.0"
  }
}
